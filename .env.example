# ── Required ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── Model ─────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
MAX_TOKENS=4096
TEMPERATURE=0.2
MAX_ITERATIONS=10
MAX_RETRIES=3

# ── API server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
# Set to require "Authorization: Bearer <API_KEY>" on all endpoints except /health
API_KEY=

# ── Task queue & dashboard ────────────────────────────────
# Background workers that process tasks assigned from the dashboard
TASK_WORKERS=2
# SQLite file where tasks (and their traces) are stored
TASKS_DB=tasks.db
# How many recent events the live activity feed keeps in memory
EVENT_BUFFER=500

# ── Optional tool keys ────────────────────────────────────
WEATHER_API_KEY=

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=agent.log

# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
MAX_TOKENS=4096
TEMPERATURE=0.2
MAX_ITERATIONS=10
MAX_RETRIES=3
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
# Set to require "Authorization: Bearer <API_KEY>" on all endpoints except /health
API_KEY=
WEATHER_API_KEY=
SERPER_API_KEY=
LOG_LEVEL=INFO
LOG_FILE=agent.log
REDIS_URL=
SESSION_TTL=3600
# Browser access: origins allowed to call the API (comma-separated, or *)
ALLOWED_ORIGINS=*
# For public sites, turn off risky tools, e.g. DISABLED_TOOLS=python_executor,file_reader
DISABLED_TOOLS=
RATE_LIMIT_PER_MIN=20

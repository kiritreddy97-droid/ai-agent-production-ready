# ── Required ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── Model ─────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
MAX_TOKENS=4096
TEMPERATURE=0.2
MAX_ITERATIONS=10
MAX_RETRIES=3

# ── API server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
# Set to require "Authorization: Bearer <API_KEY>" on all endpoints except /health
API_KEY=

# ── Task queue & dashboard ────────────────────────────────
# Background workers that process tasks assigned from the dashboard
TASK_WORKERS=2
# SQLite file where tasks (and their traces) are stored
TASKS_DB=tasks.db
# How many recent events the live activity feed keeps in memory
EVENT_BUFFER=500

# ── LinkedIn autopilot ────────────────────────────────────
# Where your work comes from
GITHUB_USERNAME=kiritreddy97-droid
# Optional: raises GitHub's rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
# Comma-separated repo names never to post about
GITHUB_EXCLUDE=
# Your ORCID iD (most accurate), or your name as it appears on Zenodo
ZENODO_ORCID=
ZENODO_AUTHOR=Kirit Reddy Daida

# LinkedIn app credentials — create at https://www.linkedin.com/developers/apps
# (add products "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect",
#  and add the redirect URL below under Auth → Authorized redirect URLs)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/linkedin/callback

# When to post (days: mon,tue,wed,thu,fri,sat,sun)
LINKEDIN_POST_DAYS=mon,thu
LINKEDIN_POST_TIME=09:00
# IANA time zone, e.g. America/New_York, America/Denver, Europe/London, Asia/Kolkata
LINKEDIN_TIMEZONE=UTC
# false = drafts wait for your approval in the dashboard; true = full autopilot
LINKEDIN_AUTO_PUBLISH=false
# How far ahead each post is drafted (gives you time to review)
LINKEDIN_DRAFT_AHEAD_HOURS=48

# ── Optional tool keys ────────────────────────────────────
WEATHER_API_KEY=

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=agent.log

# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
MAX_TOKENS=4096
TEMPERATURE=0.2
MAX_ITERATIONS=10
MAX_RETRIES=3
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
# Set to require "Authorization: Bearer <API_KEY>" on all endpoints except /health
API_KEY=
WEATHER_API_KEY=
SERPER_API_KEY=
LOG_LEVEL=INFO
LOG_FILE=agent.log
REDIS_URL=
SESSION_TTL=3600
